{
  "manifest_version": 3,
  "name": "网申资料助手",
  "version": "1.1.0",
  "description": "从应聘记录本地资料库匹配字段并填入网申表单。点击图标在当前页面启用。",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "启用网申助手"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1:8787/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "icon.png"
  },
  "minimum_chrome_version": "116"
}
